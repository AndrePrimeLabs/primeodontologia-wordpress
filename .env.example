# WordPress Environment Configuration (.env)
# Copy this file to .env and adjust values for your local or hosting environment:
# cp .env.example .env

# ==========================================
# 1. Database Configuration (MySQL / MariaDB)
# ==========================================
# (Note: In WordPress Studio, local development uses SQLite automatically)
DB_NAME="primeodontologia_local"
DB_USER="root"
DB_PASSWORD="root_password"
DB_HOST="localhost"

# ==========================================
# 2. WordPress URLs & Environment
# ==========================================
# For local Studio: http://localhost:8882
# For Docker: http://localhost:8080
# For Production: https://primeodontologia.com.br
WP_HOME="http://localhost:8882"
WP_SITEURL="http://localhost:8882"
WP_ENVIRONMENT_TYPE="development" # development | staging | production | local

# ==========================================
# 3. Notion CMS Integration
# ==========================================
# Notion Secret & Database ID for content sync
NOTION_TOKEN="secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NOTION_DATABASE_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# WordPress REST API Application Password (generated in WP-Admin -> Users -> Profile)
WP_USER="admin"
WP_APP_PASSWORD="xxxx xxxx xxxx xxxx xxxx xxxx"
SYNC_PUBLISH_MODE="direct" # direct | draft
