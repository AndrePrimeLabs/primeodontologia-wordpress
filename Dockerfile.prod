# syntax=docker/dockerfile:1
FROM wordpress:php8.3-apache

ENV APACHE_DOCUMENT_ROOT=/var/www/html

RUN a2enmod rewrite expires headers

# Production image: WordPress core comes from the trusted base image.
# Only the application-owned theme and static ads.txt enter this image.
COPY --chown=www-data:www-data wp-content/themes/prime-odontologia /var/www/html/wp-content/themes/prime-odontologia
COPY --chown=www-data:www-data ads.txt /var/www/html/ads.txt

RUN { \
      echo 'memory_limit=256M'; \
      echo 'upload_max_filesize=64M'; \
      echo 'post_max_size=64M'; \
      echo 'max_execution_time=120'; \
      echo 'display_errors=Off'; \
      echo 'log_errors=On'; \
    } > /usr/local/etc/php/conf.d/prime-production.ini

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=5 \
  CMD curl --fail --silent http://localhost/wp-login.php > /dev/null || exit 1
