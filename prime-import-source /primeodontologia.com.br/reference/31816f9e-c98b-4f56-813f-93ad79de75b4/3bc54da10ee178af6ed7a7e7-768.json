":13,"lineHeight":75,"letterSpacing":1,"advance":102.36,"loaded":true},{"key":"O que é a Mordida cruzada?","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"500","fontSize":25,"lineHeight":32.5,"letterSpacing":-0.6,"advance":326,"loaded":true},{"key":"Publicado em","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"600","fontSize":12,"lineHeight":20.4,"letterSpacing":1.5,"advance":78.41,"loaded":true},{"key":"6 de novembro de 2025","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"600","fontSize":12,"lineHeight":20.4,"letterSpacing":1.5,"advance":133.74,"loaded":true},{"key":"por","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"600","fontSize":12,"lineHeight":20.4,"letterSpacing":1.5,"advance":19.26,"loaded":true},{"key":"dr.andrealmeida","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"600","fontSize":12,"lineHeight":20.4,"letterSpacing":1.5,"advance":92.5,"loaded":true},{"key":"A mordida cruzada é um tipo de má oclusão em que os dentes superiores e inferiores não se encaixam corretamente.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":711.48,"loaded":true},{"key":"Ocasionando com que alguns dentes de cima fechem por dentro dos dentes de baixo, ao contrário do que seria o ideal.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":723.27,"loaded":true},{"key":"???? Causas, tipos, sintomas e tratamentos","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":256.41,"loaded":true},{"key":"Essa alteração pode afetar apenas um dente ou toda a arcada e pode ocorrer na infância, adolescência ou continuar na fas","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":794.2,"loaded":true},{"key":"Além de prejudicar a estética, a mordida cruzada pode comprometer a respiração, a mastigação, o crescimento facial e até","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":972.57,"loaded":true},{"key":"Mordida Cruzada","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13,"lineHeight":17.55,"letterSpacing":0,"advance":102.66,"loaded":true},{"key":"???? O que é mordida cruzada?","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":187.95,"loaded":true},{"key":"A mordida cruzada acontece quando os dentes superiores não ficam posicionados mais externamente em relação aos dentes in","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":953.15,"loaded":true},{"key":"Em vez disso, eles se posicionam por dentro ou totalmente invertidos, alterando a relação ideal das arcadas.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":653.52,"loaded":true},{"key":"A mordida cruzada pode ser:","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":174.27,"loaded":true},{"key":"• Anterior","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":56.27,"loaded":true},{"key":"• Posterior","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":62,"loaded":true},{"key":"• Unilateral (apenas de um lado)","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":192.88,"loaded":true},{"key":"• Bilateral (dos dois lados)","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":154.8,"loaded":true},{"key":"• Dentária ou esquelética","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":151.5,"loaded":true},{"key":"???? Quais são as causas da mordida cruzada?","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":279.56,"loaded":true},{"key":"A mordida cruzada pode surgir por:","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":213.61,"loaded":true},{"key":"✔ Fatores genéticos","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":121.91,"loaded":true},{"key":"É comum em famílias que apresentam maxila estreita ou mandíbula mais desenvolvida.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":529.62,"loaded":true},{"key":"✔ Falta de espaço na arcada superior","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":226.24,"loaded":true},{"key":"Quando o osso da maxila é estreito, os dentes não se posicionam corretamente.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":482.54,"loaded":true},{"key":"✔ Hábitos orais","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":92.69,"loaded":true},{"key":"• Chupar dedo","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":87.42,"loaded":true},{"key":"• Uso prolongado de chupeta","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":178.22,"loaded":true},{"key":"• Interposição lingual (língua empurrando dentes)","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":298.22,"loaded":true},{"key":"Esses hábitos alteram o crescimento e posicionamento das arcadas.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":411.64,"loaded":true},{"key":"✔ Respiração bucal","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":118.85,"loaded":true},{"key":"Problemas como rinite, adenoide ou desvio de septo podem causar estreitamento da arcada superior.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":614.94,"loaded":true},{"key":"✔ Erupção irregular dos dentes","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":189.9,"loaded":true},{"key":"Dentes que nascem fora da posição podem empurrar outros e gerar mordida cruzada.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":521.41,"loaded":true},{"key":"✔ Traumas e perdas dentárias","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":181.9,"loaded":true},{"key":"A perda precoce de dentes de leite pode causar desalinhamentos posteriores.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":473.8,"loaded":true},{"key":"???? Diferentes tipos de mordida cruzada","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":248.23,"loaded":true},{"key":"– Mordida cruzada anterior","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":162.58,"loaded":true},{"key":"Ocorre quando os dentes inferiores ficam à frente dos superiores (parte da frente da boca).","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":547.2,"loaded":true},{"key":"– Mordida cruzada posterior","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":170.09,"loaded":true},{"key":"Quando os dentes superiores de trás fecham por dentro dos inferiores.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":426.87,"loaded":true},{"key":"– Mordida cruzada unilateral","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":172.22,"loaded":true},{"key":"Acontece apenas de um lado da arcada.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":243.59,"loaded":true},{"key":"4. Mordida cruzada bilateral","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":167.06,"loaded":true},{"key":"Ocorre dos dois lados e geralmente indica problemas esqueléticos.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":407.81,"loaded":true},{"key":"⸻","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":34.32,"loaded":true},{"key":"Quais são os sintomas e consequências da mordida cruzada?","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":370.14,"loaded":true},{"key":"A mordida cruzada pode causar desde desconforto até alterações funcionais importantes:","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":544.35,"loaded":true},{"key":"• Dificuldade para mastigar adequadamente","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":266.89,"loaded":true},{"key":"• Desgaste irregular dos dentes","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":189.82,"loaded":true},{"key":"• Dor na ATM (articulação da mandíbula)","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":242.51,"loaded":true},{"key":"• Estalos ao abrir ou fechar a boca","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":205.34,"loaded":true},{"key":"• Assimetria facial","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":106.56,"loaded":true},{"key":"• Respiração bucal","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":112.35,"loaded":true},{"key":"• Desalinhamento progressivo da arcada","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":243.99,"loaded":true},{"key":"• Problemas na fala","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":116.9,"loaded":true},{"key":"• Maior risco de cáries e gengivite (dentes difíceis de limpar)","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":361.16,"loaded":true},{"key":"Quando não tratada, tende a piorar com o tempo.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":298.4,"loaded":true},{"key":"⸻","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":34.32,"loaded":true},{"key":"???? Como é feito o diagnóstico?","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":196.9,"loaded":true},{"key":"O dentista realiza:","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":106.86,"loaded":true},{"key":"• Avaliação clínica da mordida","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":180.58,"loaded":true},{"key":"• Fotografias intra e extraorais","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":178.16,"loaded":true},{"key":"• Escaneamento intraoral ou moldagens","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":242.39,"loaded":true},{"key":"• Radiografias (se necessário)","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":175.06,"loaded":true},{"key":"• Análise do crescimento facial (em crianças)","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":268.85,"loaded":true},{"key":"O diagnóstico determina se a mordida cruzada é dentária (dentes mal posicionados) ou esquelética (questões ósseas).","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":714.4,"loaded":true},{"key":"⸻","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":34.32,"loaded":true},{"key":"???? Como tratar a mordida cruzada?","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":222.9,"loaded":true},{"key":"A boa notícia é que existem tratamentos eficazes, especialmente quando o problema é tratado cedo.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":610.05,"loaded":true},{"key":"⸻","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":34.32,"loaded":true},{"key":"???? 1. Tratamento em crianças (o ideal!)","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":239.89,"loaded":true},{"key":"Durante a infância, é possível atuar no crescimento ósseo. Os tratamentos mais comuns são:","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":556.39,"loaded":true},{"key":"• Expansão da maxila (expansor)","fo