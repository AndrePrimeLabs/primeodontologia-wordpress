.3125,"letterSpacing":0,"advance":768.72,"loaded":true},{"key":"⸻","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":34.32,"loaded":true},{"key":"???? Quais são as causas do prognatismo?","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":254.34,"loaded":true},{"key":"As causas podem ser hereditárias ou adquiridas. As principais são:","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":398.47,"loaded":true},{"key":"✔ 1. Fatores genéticos (a mais comum)","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":232.87,"loaded":true},{"key":"O prognatismo frequentemente é herdado de familiares. Se pais ou avós têm queixo projetado, há maior chance de a criança","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":833.18,"loaded":true},{"key":"✔ 2. Crescimento ósseo alterado","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":197.12,"loaded":true},{"key":"Durante o desenvolvimento, a mandíbula pode crescer mais do que o normal, ou a maxila pode crescer menos.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":673.52,"loaded":true},{"key":"✔ 3. Problemas respiratórios e hábitos orais","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":261.34,"loaded":true},{"key":"Respiração bucal, interposição lingual e sucção prolongada podem influenciar o desenvolvimento ósseo.","fontFamily":"Raleway,