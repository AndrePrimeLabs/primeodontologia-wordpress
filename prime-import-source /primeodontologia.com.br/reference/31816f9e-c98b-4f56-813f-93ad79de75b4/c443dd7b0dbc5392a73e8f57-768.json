rial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":274.13,"loaded":true},{"key":"A gengiva é responsável por proteger os dentes e manter o osso que os sustenta.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":493.09,"loaded":true},{"key":"Quando não é bem higienizada, placa bacteriana se acumula e provoca inflamação.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":504.21,"loaded":true},{"key":"Problemas gengivais podem causar:","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":219.44,"loaded":true},{"key":"• Sangramento","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":89.99,"loaded":true},{"key":"• Mau hálito","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":71,"loaded":true},{"key":"• Dor e sensibilidade","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":123.55,"loaded":true},{"key":"• Retração gengival","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":117.54,"loaded":true},{"key":"• Aumento de mobilidade dos dentes","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":225.6,"loaded":true},{"key":"• Perda óssea","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":82.1,"loaded":true},{"key":"• Perda dentária","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":96.37,"loaded":true},{"key":"Ou seja: cuidar da gengiva é fundamental para preservar seu sorriso por toda a vida.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":507.13,"loaded":true},{"key":"Gengivite","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13,"lineHeight":17.55,"letterSpacing":0,"advance":57,"loaded":true},{"key":"???? Como cuidar da gengiva no dia a dia? (Passo a passo)","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":350.26,"loaded":true},{"key":"– Escove os dentes corretamente","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":202.69,"loaded":true},{"key":"A escovação deve ser suave, com movimentos circulares e varridos na região próxima à gengiva.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":584.33,"loaded":true},{"key":"Força excessiva machuca e pode causar retração.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":300.51,"loaded":true},{"key":"Dicas:","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":35.4,"loaded":true},{"key":"✔ Use escova de cerdas extra macias","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":227.41,"loaded":true},{"key":"✔ Escove de 2 a 4 vezes ao dia","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":186.2,"loaded":true},{"key":"✔ Não esqueça de limpar a linha da gengiva","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":268.8,"loaded":true},{"key":"– Use o fio dental todos os dias","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":188.52,"loaded":true},{"key":"O fio dental remove restos e placa bacteriana entre os dentes.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":374.21,"loaded":true},{"key":"Benefícios:","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":65.57,"loaded":true},{"key":"• Reduz sangramento","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":130.15,"loaded":true},{"key":"• Previne gengivite","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":112.81,"loaded":true},{"key":"• Evita acúmulo de tártaro","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":156.28,"loaded":true},{"key":"– Prefira creme dental com flúor","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":195.21,"loaded":true},{"key":"O flúor fortalece o esmalte, reduz a sensibilidade e ajuda a controlar a placa bacteriana.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":528.56,"loaded":true},{"key":"– Limpe a língua","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":100.15,"loaded":true},{"key":"A língua acumula bactérias que contribuem para mau hálito e inflamação gengival.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":500.6,"loaded":true},{"key":"Use limpador de língua ou escova.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":208.6,"loaded":true},{"key":"– Use enxaguante bucal com orientação profissional","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":316.59,"loaded":true},{"key":"Alguns enxaguantes ajudam a controlar bactérias e inflamação, mas nem todos são adequados para uso diário.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":671.38,"loaded":true},{"key":"Evite versões com álcool, pois podem causar irritação.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":327.29,"loaded":true},{"key":"– Não escove com força","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":146.79,"loaded":true},{"key":"Escovar com força não limpa melhor e ainda pode machucar a gengiva.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":433.12,"loaded":true},{"key":"Isso pode causar retração gengival e sensibilidade.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":307.64,"loaded":true},{"key":"Utilize movimentos suaves e controlados.",