eight":"500","fontSize":32,"lineHeight":48,"letterSpacing":-0.6,"advance":417.28,"loaded":true},{"key":"Publicado em","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"600","fontSize":12,"lineHeight":20.4,"letterSpacing":1.5,"advance":78.41,"loaded":true},{"key":"6 de novembro de 2025","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"600","fontSize":12,"lineHeight":20.4,"letterSpacing":1.5,"advance":133.74,"loaded":true},{"key":"por","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"600","fontSize":12,"lineHeight":20.4,"letterSpacing":1.5,"advance":19.26,"loaded":true},{"key":"dr.andrealmeida","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"600","fontSize":12,"lineHeight":20.4,"letterSpacing":1.5,"advance":92.5,"loaded":true},{"key":"A mordida cruzada é um tipo de má oclusão em que os dentes superiores e inferiores não se encaixam corretamente.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":759.2,"loaded":true},{"key":"Ocasionando com que alguns dentes de cima fechem por dentro dos dentes de baixo, ao contrário do que seria o ideal.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":771.78,"loaded":true},{"key":"???? Causas, tipos, sintomas e tratamentos","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":273.61,"loaded":true},{"key":"Essa alteração pode afetar apenas um dente ou toda a arcada e pode ocorrer na infância, adolescência ou continuar na fas","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":847.47,"loaded":true},{"key":"Além de prejudicar a estética, a mordida cruzada pode comprometer a respiração, a mastigação, o crescimento facial e até","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":1037.8,"loaded":true},{"key":"Mordida Cruzada","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13,"lineHeight":17.55,"letterSpacing":0,"advance":102.66,"loaded":true},{"key":"???? O que é mordida cruzada?","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":200.56,"loaded":true},{"key":"A mordida cruzada acontece quando os dentes superiores não ficam posicionados mais externamente em relação aos dentes in","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":1017.08,"loaded":true},{"key":"Em vez disso, eles se posicionam por dentro ou totalmente invertidos, alterando a relação ideal das arcadas.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":697.35,"loaded":true},{"key":"A mordida cruzada pode ser:","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":185.96,"loaded":true},{"key":"• Anterior","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":60.04,"loaded":true},{"key":"• Posterior","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":66.15,"loaded":true},{"key":"• Unilateral (apenas de um lado)","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":205.82,"loaded":true},{"key":"• Bilateral (dos dois lados)","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":165.18,"loaded":true},{"key":"• Dentária ou esquelética","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":161.66,"loaded":true},{"key":"???? Quais são as causas da mordida cruzada?","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":298.31,"loaded":true},{"key":"A mordida cruzada pode surgir por:","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":227.94,"loaded":true},{"key":"✔ Fatores genéticos","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":130.09,"loaded":true},{"key":"É comum em famílias que apresentam maxila estreita ou mandíbula mais desenvolvida.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":565.14,"loaded":true},{"key":"✔ Falta de espaço na arcada superior","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":241.41,"loaded":true},{"key":"Quando o osso da maxila é estreito, os dentes não se posicionam corretamente.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":514.91,"loaded":true},{"key":"✔ Hábitos orais","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":98.91,"loaded":true},{"key":"• Chupar dedo","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":93.29,"loaded":true},{"key":"• Uso prolongado de chupeta","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":190.17,"loaded":true},{"key":"• Interposição lingual (língua empurrando dentes)","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":318.22,"loaded":true},{"key":"Esses hábitos alteram o crescimento e posicionamento das arcadas.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":439.25,"loaded":true},{"key":"✔ Respiração bucal","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":126.82,"loaded":true},{"key":"Problemas como rinite, adenoide ou desvio de septo podem causar estreitamento da arcada superior.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":656.19,"loaded":true},{"key":"✔ Erupção irregular dos dentes","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":202.64,"loaded":true},{"key":"Dentes que nascem fora da posição podem empurrar outros e gerar mordida cruzada.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":556.38,"loaded":true},{"key":"✔ Traumas e perdas dentárias","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":194.1,"loaded":true},{"key":"A perda precoce de dentes de leite pode causar desalinhamentos posteriores.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":505.58,"loaded":true},{"key":"???? Diferentes tipos de mordida cruzada","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":264.88,"loaded":true},{"key":"– Mordida cruzada anterior","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":173.49,"loaded":true},{"key":"Ocorre quando os dentes inferiores ficam à frente dos superiores (parte da frente da boca).","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":583.9,"loaded":true},{"key":"– Mordida cruzada posterior","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":181.5,"loaded":true},{"key":"Quando os dentes superiores de trás fecham por dentro dos inferiores.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":455.51,"loaded":true},{"key":"– Mordida cruzada unilateral","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":183.78,"loaded":true},{"key":"Acontece apenas de um lado da arcada.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":259.92,"loaded":true},{"key":"4. Mordida cruzada bilateral","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":178.26,"loaded":true},{"key":"Ocorre dos dois lados e geralmente indica problemas esqueléticos.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":435.16,"loaded":true},{"key":"⸻","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":36.56,"loaded":true},{"key":"Quais são os sintomas e consequências da mordida cruzada?","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":394.96,"loaded":true},{"key":"A mordida cruzada pode causar desde desconforto até alterações funcionais importantes:","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":580.86,"loaded":true},{"key":"• Dificuldade para mastigar adequadamente","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":284.79,"loaded":true},{"key":"• Desgaste irregular dos dentes","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":202.55,"loaded":true},{"key":"• Dor na ATM (articulação da mandíbula)","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":258.77,"loaded":true},{"key":"• Estalos ao abrir ou fechar a boca","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":219.12,"loaded":true},{"key":"• Assimetria facial","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":113.7,"loaded":true},{"key":"• Respiração bucal","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":119.89,"loaded":true},{"key":"• Desalinhamento progressivo da arcada","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":260.35,"loaded":true},{"key":"• Problemas na fala","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":124.74,"loaded":true},{"key":"• Maior risco de cáries e gengivite (dentes difíceis de limpar)","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":385.38,"loaded":true},{"key":"Quando não tratada, tende a piorar com o tempo.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":318.41,"loaded":true},{"key":"⸻","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":36.56,"loaded":true},{"key":"???? Como é feito o diagnóstico?","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":210.11,"loaded":true},{"key":"O dentista realiza:","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":114.03,"loaded":true},{"key":"• Avaliação clínica da mordida","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":192.69,"loaded":true},{"key":"• Fotografias intra e extraorais","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":190.11,"loaded":true},{"key":"• Escaneamento intraoral ou moldagens","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":258.65,"loaded":true},{"key":"• Radiografias (se necessário)","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":186.8,"loaded":true},{"key":"• Análise do crescimento facial (em crianças)","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":286.89,"loaded":true},{"key":"O diagnóstico determina se a mordida cruzada é dentária (dentes mal posicionados) ou esquelética (questões ósseas).","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":762.31,"loaded":true},{"key":"⸻","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":36.56,"loaded":true},{"key":"???? Como tratar a mordida cruzada?","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":237.85,"loaded":true},{"key":"A boa notícia é que existem tratamentos eficazes, especialmente quando o problema é tratado cedo.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":650.96,"loaded":true},{"key":"⸻","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":36.56,"loaded":true},{"key":"???? 1. Tratamento em crianças (o ideal!)","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":255.98,"loaded":true},{"key":"Durante a infância, é possível atuar no crescimento ósseo. Os tratamentos mais comuns são:","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":593.7,"loaded":true},{"key":"• Expansão da maxila (expansor)","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":206.84,"loaded":true},{"key":"• Aparelhos ortopédicos funcionais","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":224.57,"loaded":true},{"key":"• Mantenedores de espaço","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":14,"lineHeight":23.8,"letterSpacing":0,"advance":173.54,"loaded":true},{"key":"• Correção de hábitos orais prejudiciais","fontFamily":"Raleway, Helvetica, Arial, sans