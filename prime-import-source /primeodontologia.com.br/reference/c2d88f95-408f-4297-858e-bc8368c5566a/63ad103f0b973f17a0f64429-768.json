rial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":902.5,"loaded":true},{"key":"Paciente e o Invisalign","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13,"lineHeight":17.55,"letterSpacing":0,"advance":133.14,"loaded":true},{"key":"Posso remover os alinhadores sempre que precisar?","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":316.22,"loaded":true},{"key":"Sim.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"600","fontSize":15.9375,"lineHeight":17.5312,"letterSpacing":0,"advance":31.76,"loaded":true},{"key":"Você pode remover os alinhadores e deve retirar o alinhador Invisalign para comer e beber líquido.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"600","fontSize":15.9375,"lineHeight":17.5312,"letterSpacing":0,"advance":741.59,"loaded":true},{"key":"Ao escovar os dentes e quando for passar o fio dental.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"600","fontSize":15.9375,"lineHeight":17.5312,"letterSpacing":0,"advance":405.78,"loaded":true},{"key":"Pode ainda removê-los para ocasiões especiais, como em ir em um casamento, a uma entrevista de trabalho ou para praticar","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":864.74,"loaded":true},{"key":"O nosso dentista recomenda que você utilize o Invisalign, pelo máximo de tempo durante o seu dia.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":602.22,"loaded":true},{"key":"Você deve usar diariamente os alinhadores Invisalign, mas, normalmente, as pessoas usam de 20 a 22 horas por dia para te","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":894.6,"loaded":true},{"key":"Caso você se esqueça de utilizar ou ocorra algum imprevisto, utilize por mais dias antes de trocar o alinhador, compensa","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":1020.9,"loaded":true},{"key":"Por exemplo:","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":79.24,"loaded":true},{"key":"Viajou no final de semana e esqueceu de levar ou utilizar o Invisalign?","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":420.82,"loaded":true},{"key":"Utilize ele repondo os dias perdidos de não utilizar o aparelho Invisalign!.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":438.63,"loaded":true},{"key":"Existe alguma restrição alimentar durante o tratamento?","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":339.3,"loaded":true},{"key":"Nenhuma!","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"600","fontSize":15.9375,"lineHeight":17.5312,"letterSpacing":0,"advance":78.53,"loaded":true},{"key":"Os alinhadores Invisalign são removíveis, portanto, não há nenhuma restrição alimentar.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":526.04,"loaded":true},{"key":"Possuímos dietas especificas para os pacientes em tratamento, o nosso dentista consegue te orientar com relação aos melh","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":1137.37,"loaded":true},{"key":"O tratamento Invisalign é doloroso?","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"600","fontSize":15.9375,"lineHeight":17.5312,"letterSpacing":0,"advance":267.31,"loaded":true},{"key":"O tratamento Invisalign movimenta os dentes exercendo uma força suave e constante, algumas pessoas sentem um pouco de de","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":1374.61,"loaded":true},{"key":"Porém essas forças e dores são menores, quando comparadas com o tratamento tradicional, como os aparelhos metálicos.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":745.21,"loaded":true},{"key":"Geralmente, as pessoas descrevem essa sensação como uma “pressão”, o que é normal.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":534.57,"loaded":true},{"key":"Pois é um sinal de que os alinhadores transparentes Invisalign estão funcionando e movimentando os seus dentes e dessa m","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":971.1,"loaded":true},{"key":"Converse","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":57.41,"loaded":true},{"key":"sempre com o nosso dentista em caso de dúvidas.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":306.45,"loaded":true},{"key":"Anti-inflamatorios não são indicados, pois podem atrapalhar o processo do tratamento com Invisalign.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":615.15,"loaded":true},{"key":"Seria parecido com a dor de ir academia e treinar quando você esta parado ou ausente dos exercícios.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":618.13,"loaded":true},{"key":"O aparelho Invisalign","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13,"lineHeight":17.55,"letterSpacing":0,"advance":125.17,"loaded":true},{"key":"O tratamento Invisalign funciona mesmo se usar os alinhadores apenas quando dormir?","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"600","fontSize":15.9375,"lineHeight":17.5312,"letterSpacing":0,"advance":659.46,"loaded":true},{"key":"É recomendável que você utilize os alinhadores Invisalign de 20 a 22 horas por dia para alcançar os resultados pretendid","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":744.2,"loaded":true},{"key":"Caso voce não consiga utilizar por no mínimo 12 horas por dia, o seu tratamento pode ter um atraso.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":602.67,"loaded":true},{"key":"Entretanto, não se preocupe pois a Invisalign pensou no seu caso e desenvolveu o tratamento Comprehensive, dessa forma o","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":1586.3,"loaded":true},{"key":"Os alinhadores podem cair enquanto estiver dormindo?","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"600","fontSize":30,"lineHeight":36,"letterSpacing":0,"advance":786.84,"loaded":true},{"key":"É muito improvável que os alinhadores caiam, independentemente da atividade que exercer: dormir, falar, rir etc.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":677.77,"loaded":true},{"key":"Os alinhadores transparentes Invisalign foram projetados para se encaixar corretamente aos dentes, portanto, isso não de","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":886.08,"loaded":true},{"key":"Fiz uma viagem e esqueci de levar os alinhadores. Eles ainda vão servir quando voltar?","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"600","fontSize":15.9375,"lineHeight":17.5312,"letterSpacing":0,"advance":651.36,"loaded":true},{"key":"A resposta depende do tempo que você ficou sem usar os alinhadores Invisalign.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":489.96,"loaded":true},{"key":"Se foi por um período curto, os alinhadores ainda devem servir, mas você poderá sentir algum desconforto ao recolocá-los","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":744.43,"loaded":true},{"key":"Se foi um período mais longo, fale com o nosso dentista sobre a sua situação específica.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":532.45,"loaded":true},{"key":"É recomendável que quando viajar utilizar eles pelo menos para dormir, para que o tempo sem utilizar não seja grande o d","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":1006.72,"loaded":true},{"key":"Os nossos dentes tendem a voltar para a posição natural deles, por isso é importante fazer o tratamento utilizando o máx","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":819,"loaded":true},{"key":"O dentista recomenda que você, evite trocar o alinhador seguinte e continue com o mesmo alinhador de acordo com o period","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":1023.09,"loaded":true},{"key":"Qual é a melhor forma de limpar o Invisalign?","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"600","fontSize":30,"lineHeight":36,"letterSpacing":0,"advance":641.32,"loaded":true},{"key":"A melhor forma de limpar os alinhadores é usando uma escova de dentes de cerdas extra macias, água e um pouco de creme d","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":808.7,"loaded":true},{"key":"Uma dica útil é escovar a parte externa dos alinhadores enquanto estiverem encaixados nos dentes e, depois, retirá-los p","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":851.05,"loaded":true},{"key":"Lembre-se de sempre escovar os dentes após cada refeição antes de recolocar os alinhadores para manter uma boa higiene b","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":796,"loaded":true},{"key":"Com o passar do tempo o alinhador vai manchando com restos de comida e líquido, sugiro deixar ele de molho em um recipie","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":1347.51,"loaded":true},{"key":"É indicado deixar em um recipiente de vidro o Invisalign com água filtrada e Clorexidina 2% para ajudar na limpeza deles","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":727.47,"loaded":true},{"key":"Converse sempre com o nosso dentista para orientações a respeito de seu tratamento.","fo