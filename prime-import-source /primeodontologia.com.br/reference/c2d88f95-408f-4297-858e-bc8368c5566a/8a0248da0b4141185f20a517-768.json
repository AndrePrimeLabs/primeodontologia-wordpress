, Helvetica, Arial, sans-serif","fontWeight":"500","fontSize":25,"lineHeight":32.5,"letterSpacing":-0.6,"advance":289.52,"loaded":true},{"key":"Publicado em","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"600","fontSize":12,"lineHeight":20.4,"letterSpacing":1.5,"advance":78.41,"loaded":true},{"key":"6 de novembro de 2025","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"600","fontSize":12,"lineHeight":20.4,"letterSpacing":1.5,"advance":133.74,"loaded":true},{"key":"por","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"600","fontSize":12,"lineHeight":20.4,"letterSpacing":1.5,"advance":19.26,"loaded":true},{"key":"dr.andrealmeida","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"600","fontSize":12,"lineHeight":20.4,"letterSpacing":1.5,"advance":92.5,"loaded":true},{"key":"A mordida aberta anterior é um tipo de má oclusão caracterizada pela falta de contato entre os dentes da frente, mesmo q","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":963.02,"loaded":true},{"key":"Ou seja, ao fechar a boca, os dentes posteriores se encostam, mas os dentes anteriores permanecem separados.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":682.65,"loaded":true},{"key":"Essa alteração pode afetar a estética do sorriso, a fala, a mastigação e até a respiração.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":524.24,"loaded":true},{"key":"Antes e Depois do tratamento","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13,"lineHeight":17.55,"letterSpacing":0,"advance":179.4,"loaded":true},{"key":"???? O que é a mordida aberta anterior?","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":239.25,"loaded":true},{"key":"A mordida aberta anterior ocorre quando os dentes superiores e inferiores da região da frente não se tocam ao fechar a b","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":757.85,"loaded":true},{"key":"O espaço pode ser pequeno ou bastante evidente, dependendo da gravidade.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":474.01,"loaded":true},{"key":"Ela pode surgir:","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":93.75,"loaded":true},{"key":"• Na infância","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":75.27,"loaded":true},{"key":"• Durante a adolescência","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":150.68,"loaded":true},{"key":"• Ou persistir na fase adulta","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":165.29,"loaded":true},{"key":"E, diferentemente de outros desalinhamentos, não se resolve sozinho — exige avaliação e intervenção profissional.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":691.18,"loaded":true},{"key":"???? O que causa a mordida aberta anterior?","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":267.19,"loaded":true},{"key":"A mordida aberta pode ter origem dentoalveolar, funcional ou esquelética. Entre as causas mais comuns:","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":633.87,"loaded":true},{"key":"– Hábitos infantis prolongados","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":183.62,"loaded":true},{"key":"✔ Chupar dedo","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":93.91,"loaded":true},{"key":"✔ Uso prolongado de chupeta","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":184.71,"loaded":true},{"key":"✔ Mamadeira noturna","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":132.99,"loaded":true},{"key":"✔ Morder objetos","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":106.81,"loaded":true},{"key":"Esses hábitos empurram os dentes, causando o afastamento dos anteriores.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":460.01,"loaded":true},{"key":"– Interposição lingual (empurrar a língua)","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":247.22,"loaded":true},{"key":"Ao engolir, falar ou até em repouso, a língua pode se posicionar entre os dentes, impedindo o fechamento.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":642.89,"loaded":true},{"key":"– Problemas respiratórios","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":154.22,"loaded":true},{"key":"Crianças que respiram pela boca podem desenvolver alterações musculares que afetam o posicionamento dos dentes.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":721.9,"loaded":true},{"key":"– Questões genéticas e crescimento ósseo","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":259.84,"loaded":true},{"key":"Em alguns casos, a mordida aberta é de origem esquelética, relacionada ao crescimento da face e da mandíbula.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":684.7,"loaded":true},{"key":"– Perda precoce de dentes","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":163.91,"loaded":true},{"key":"Especialmente os posteriores, o que altera o equilíbrio da mordida.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":403.63,"loaded":true},{"key":"Mordida aberta","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13,"lineHeight":17.55,"letterSpacing":0,"advance":91.56,"loaded":true},{"key":"Quais os sintomas e consequências da mordida aberta anterior?","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":386.28,"loaded":true},{"key":"Além do espaço aparente entre os dentes, a mordida aberta pode causar:","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":445.26,"loaded":true},{"key":"• Dificuldade para cortar alimentos (morder maçã, sanduíche)","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":369.26,"loaded":true},{"key":"• Problemas na fala: ceceio (som de “s” com ar escapando)","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":352.43,"loaded":true},{"key":"• Respiração oral","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":101.65,"loaded":true},{"key":"• Desgaste dentário irregular","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":172.67,"loaded":true},{"key":"• Mastigação ineficiente","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":142.96,"loaded":true},{"key":"• Impacto estético e emocional","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":187.52,"loaded":true},{"key":"• Alterações musculares da face","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":195.07,"loaded":true},{"key":"• Maior chances de cáries e gengivite em casos de posicionamento inadequado","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":481.94,"loaded":true},{"key":"Quanto mais cedo o diagnóstico, melhores os resultados do tratamento.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":434.8,"loaded":true},{"key":"???? Como tratar a mordida aberta anterior?","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":263.7,"loaded":true},{"key":"O tratamento varia conforme idade, causa e gravidade. Os principais são:","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":438.92,"loaded":true},{"key":"– Aparelho ortodôntico fixo","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":163.73,"loaded":true},{"key":"Alinha os dentes e corrige o fechamento inadequado da mordida.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":396.26,"loaded":true},{"key":"– Alinhadores transparentes","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":169.66,"loaded":true},{"key":"Eficientes para corrigir mordida aberta leve a moderada com conforto e estética.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":485.61,"loaded":true},{"key":"– Tratamento fonoaudiológico","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":182.09,"loaded":true},{"key":"Essencial quando há interposição lingual — corrige a forma de engolir, falar e posicionar a língua.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":584.38,"loaded":true},{"key":"– Aparelhos ortopédicos infantis","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":194.75,"loaded":true},{"key":"Em crianças, podem redirecionar o crescimento e corrigir hábitos.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":396.07,"loaded":true},{"key":"– Eliminadores de hábito","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":149.73,"loaded":true},{"key":"Feitos para crianças que chupam dedo ou chupeta.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":310.22,"loaded":true},{"key":"– Cirurgia ortognática (em casos graves em adultos)","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":313.34,"loaded":true},{"key":"Quando a causa é esquelética e o crescimento já está completo.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":389.73,"loaded":true},{"key":"???? Mordida aberta em crianças: quando procurar ajuda?","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":347.33,"loaded":true},{"key":"A mordida aberta geralmente se forma na infância por hábitos inadequados.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":459.85,"loaded":true},{"key":"Busque avaliação profissional se notar:","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":233.02,"loaded":true},{"key":"• Espaço visível entre os dentes da frente","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":248.58,"loaded":true},{"key":"• Língua aparecendo entre os dentes","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":223.15,"loaded":true},{"key":"• Uso prolongado de chupeta","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":178.22,"loaded":true},{"key":"• Dificuldade para cortar alimentos","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":208.61,"loaded":true},{"key":"• Respiração pela boca","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":138.67,"loaded":true},{"key":"Quanto mais cedo o atendimento, menores as chances de tratamentos complexos no futuro.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":559.46,"loaded":true},{"key":"A mordida aberta anterior pode parecer apenas um detalhe estético, mas está diretamente ligada à função mastigatória, fa","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":906.67,"loaded":true},{"key":"Com diagnóstico precoce e um plano de tratamento bem estruturado, é possível corrigir o problema com eficácia.","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"400","fontSize":13.125,"lineHeight":22.3125,"letterSpacing":0,"advance":690.43,"loaded":true},{"key":"Compartilhe isso:","fontFamily":"Raleway, Helvetica, Arial, sans-serif","fontWeight":"700","fontSize":12,"lineHeight":14.4,"letterSpacing":0,"advance":99.74,"loaded":true},{"key":"Facebook","fontFamily":"\"Open Sans\", sans-serif","fontWeight":"500","fontSize":13,"lineHeight":23,"letterSpacing":0,"advance":57.88,"loaded":true},{"key":"X","fontFamily":"\"Open Sans\", sans-serif","fontWeight":"500","fontSize":13,"lineHeight":23,"letterSpacing":0,"advance":7.51,"loaded":true},{"key":"Relacionado","fontFamily":"Raleway, Helvetica,