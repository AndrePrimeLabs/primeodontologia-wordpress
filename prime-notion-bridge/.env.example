# Prime Notion Bridge & CMS Sync - Environment Configuration
# Copy this file to .env and fill in your real values:
# cp .env.example .env

# ==========================================
# 1. Notion Configuration
# ==========================================
# Notion Internal Integration Token (Secret)
# Create your integration at: https://www.notion.so/my-integrations
NOTION_TOKEN="secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Notion Database ID or URL for direct CMS sync (Pages & Blog articles)
# Found in your Notion database link: https://www.notion.so/workspace/{DATABASE_ID}?v=...
NOTION_DATABASE_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# (Optional fallback) Comma-separated list of standalone Notion Page IDs or URLs
NOTION_ALLOWED_PAGES="https://www.notion.so/your-workspace/Page-Title-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ==========================================
# 2. WordPress Configuration
# ==========================================
# Target WordPress URL (no trailing slash, no /wp-admin)
# Local Studio: http://localhost:8882
# Cloud Preview: https://primeodontologiadigital-zqhjl-studio.wp.build
# Production: https://primeodontologia.com.br
WP_BASE_URL="http://localhost:8882"

# WordPress Username (Administrator or Editor)
WP_USER="admin"

# WordPress Application Password
# Generate in WP-Admin -> Users -> Profile -> Application Passwords
# (Do NOT use your regular login password; format: xxxx xxxx xxxx xxxx)
WP_APP_PASSWORD="xxxx xxxx xxxx xxxx xxxx xxxx"

# ==========================================
# 3. Sync Settings
# ==========================================
# Publish Mode: 'direct' (publish immediately when Notion Status is Published) or 'draft'
SYNC_PUBLISH_MODE="direct"

# Persistent sync state file path (optional, defaults to ./bridge-state.json)
BRIDGE_STATE_FILE="./bridge-state.json"
