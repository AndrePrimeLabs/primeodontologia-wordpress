# Prime Notion Bridge - Environment Configuration
# Copy this file to .env and fill in the values:
# cp .env.example .env

# Notion Integration Token (Internal integration, read-only)
# Create at: https://www.notion.so/my-integrations
NOTION_TOKEN="secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Comma-separated list of allowed Notion Page IDs or URLs
# Prevents unauthorized/accidental import of untrusted Notion sources
NOTION_ALLOWED_PAGES="https://www.notion.so/your-workspace/Page-Title-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Target WordPress URL (No trailing slash, no /wp-admin)
# For local Studio: http://localhost:8882
# For staging: https://staging.primeodontologia.com.br
WP_BASE_URL="http://localhost:8882"

# WordPress Integration User Username (editor or admin role)
WP_USER="admin"

# WordPress Application Password (generated in Users -> Profile -> Application Passwords)
# Format: xxxx xxxx xxxx xxxx xxxx xxxx
WP_APP_PASSWORD="xxxx xxxx xxxx xxxx xxxx xxxx"

# Persistent state file path (optional, defaults to ./bridge-state.json)
# BRIDGE_STATE_FILE="./bridge-state.json"
