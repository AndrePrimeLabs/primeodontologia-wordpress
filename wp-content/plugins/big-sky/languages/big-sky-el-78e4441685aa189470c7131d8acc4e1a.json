03b9 \u03b4\u03b9\u03b1\u03b8\u03ad\u03c3\u03b9\u03bc\u03bf\u03c2."],"%d annotation submitted":["%d \u03b1\u03bd\u03ac\u03bb\u03c5\u03c3\u03b7 \u03c5\u03c0\u03bf\u03b2\u03bb\u03ae\u03b8\u03b7\u03ba\u03b5","%d \u03c3\u03b7\u03bc\u03b5\u03b9\u03ce\u03c3\u03b5\u03b9\u03c2 \u03c5\u03c0\u03bf\u03b2\u03bb\u03ae\u03b8\u03b7\u03ba\u03b1\u03bd"],"Annotating":["\u03a3\u03b7\u03bc\u03b5\u03b9\u03ce\u03bd\u03bf\u03bd\u03c4\u03b1\u03c2"],"Discard annotations":["\u0391\u03c0\u03cc\u03c1\u03c1\u03b9\u03c8\u03b7 \u03c3\u03c7\u03bf\u03bb\u03af\u03c9\u03bd"],"Exit annotation mode":["\u0388\u03be\u03bf\u03b4\u03bf\u03c2 \u03b1\u03c0\u03cc \u03c4\u03b7 \u03bb\u03b5\u03b9\u03c4\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 \u03c3\u03c7\u03bf\u03bb\u03b9\u03b1\u03c3\u03bc\u03bf\u03cd"],"Send %d annotation":["\u03a3\u03c4\u03b5\u03af\u03bb\u03b5 %d \u03c3\u03b7\u03bc\u03b5\u03af\u03c9\u03c3\u03b7","\u03a3\u03c4\u03b5\u03af\u03bb\u03b5 %d \u03c3\u03b7\u03bc\u03b5\u03b9\u03ce\u03c3\u03b5\u03b9\u03c2"],"Sending\u2026":["\u0391\u03c0\u03bf\u03c3\u03c4\u03bf\u03bb\u03ae..."],"Send":["\u0391\u03c0\u03bf\u03c3\u03c4\u03bf\u03bb\u03ae"],"Save annotation":["\u0391\u03c0\u03bf\u03b8\u03ae\u03ba\u03b5\u03c5\u03c3\u03b7 \u03c3\u03c7\u03bf\u03bb\u03b9\u03b1\u03c3\u03bc\u03bf\u03cd"],"Update annotation":["\u0395\u03bd\u03b7\u03bc\u03ad\u03c1\u03c9\u03c3\u03b7 \u03c3\u03c7\u03bf\u03bb\u03b9\u03b1\u03c3\u03bc\u03bf\u03cd"],"Delete annotation":["\u0394\u03b9\u03b1\u03b3\u03c1\u03b1\u03c6\u03ae \u03c3\u03c7\u03bf\u03bb\u03af\u03bf\u03c5"],"Add a comment\u2026":["\u03a0\u03c1\u03cc\u03c3\u03b8\u03b5\u03c3\u03b5 \u03ad\u03bd\u03b1 \u03a3\u03c7\u03cc\u03bb\u03b9\u03bf\u2026"],"Annotate %s":["\u03a3\u03b7\u03bc\u03b5\u03af\u03c9\u03c3\u03b5 %s"],"Annotate blocks. Use the arrow keys to move between blocks, Enter to comment, and Escape to exit.":["\u03a3\u03b7\u03bc\u03b5\u03b9\u03ce\u03c3\u03c4\u03b5 \u03c4\u03b1 \u03bc\u03c0\u03bb\u03bf\u03ba. \u03a7\u03c1\u03b7\u03c3\u03b9\u03bc\u03bf\u03c0\u03bf\u03b9\u03ae\u03c3\u03c