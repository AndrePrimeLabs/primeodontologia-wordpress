43e\u0440\u0438\u0442\u0435 \u043f\u043e\u043f\u044b\u0442\u043a\u0443."],"Drafts":["\u0427\u0435\u0440\u043d\u043e\u0432\u0438\u043a\u0438"],"Close Pages":["\u0417\u0430\u043a\u0440\u044b\u0442\u044c \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u044b"],"Updated:":["\u041e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u043e:"],"Back to sites":["\u041d\u0430\u0437\u0430\u0434 \u043a \u0441\u0430\u0439\u0442\u0430\u043c"],"You can rebuild your site from here. Either build a new site with the same details, or modify them and then rebuild.":["\u0417\u0434\u0435\u0441\u044c \u0432\u044b \u043c\u043e\u0436\u0435\u0442\u0435 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043f\u0435\u0440\u0435\u0434\u0435\u043b\u0430\u0442\u044c \u0441\u0432\u043e\u0439 \u0441\u0430\u0439\u0442. \u0412\u044b \u0442\u0430\u043a\u0436\u0435 \u043c\u043e\u0436\u0435\u0442\u0435 \u0441\u043e\u0437\u0434\u0430\u0442\u044c \u043d\u043e\u0432\u044b\u0439 \u0441\u0430\u0439\u0442 \u0441 \u0442\u0435\u043c\u0438 \u0436\u0435 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430\u043c\u0438 \u0438\u043b\u0438 \u0438\u0437\u043c\u0435\u043d\u0438\u0442\u044c \u0438\u0445, \u0430 \u0437\u0430\u0442\u0435\u043c \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043f\u0435\u0440\u0435\u0434\u0435\u043b\u0430\u0442\u044c."],"Pages":["\u0421\u0442\u0440\u0430\u043d\u0438\u0446\u044b"],"Start over":["\u041d\u0430\u0447\u0430\u0442\u044c \u0441\u043d\u0430\u0447\u0430\u043b\u0430"],"Whoops! Our AI is having some issues right now. Please try again later.":["\u041e\u0439! \u0421 \u043d\u0430\u0448\u0438\u043c \u0418\u0418 \u0447\u0442\u043e-\u0442\u043e \u043d\u0435 \u0442\u0430\u043a. \u041f\u043e\u0432\u0442\u043e\u0440\u0438\u0442\u0435 \u043f\u043e\u043f\u044b\u0442\u043a\u0443 \u043f\u043e\u0437\u0436\u0435."],"Type another request \u2026":["\u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u043d\u043e\u0432\u044b\u0439 \u0437\u0430\u043f\u0440\u043e\u0441\u2026"],"Add Pages":["\u0414\u043e\u0431\u0430\u0